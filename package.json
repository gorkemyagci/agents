{
  "name": "agents",
  "version": "0.1.0",
  "private": true,
  "description": "A terminal AI agent with file, shell, code-execution and web-search tools, human-in-the-loop approval, and context compaction.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorkemyagci/agents.git"
  },
  "homepage": "https://github.com/gorkemyagci/agents#readme",
  "bugs": {
    "url": "https://github.com/gorkemyagci/agents/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "openai",
    "ink",
    "tool-calling"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "bin": {
    "agents": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/cli.ts",
    "start": "tsx --env-file=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "eval": "npx lmnr eval",
    "eval:file-tools": "npx lmnr eval evals/file-tools.eval.ts",
    "eval:shell-tools": "npx lmnr eval evals/shell-tools.eval.ts",
    "eval:agent": "npx lmnr eval evals/agent-multiturn.eval.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/shelljs": "^0.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.72",
    "@lmnr-ai/lmnr": "^0.8.54",
    "ai": "^5.0.102",
    "ink": "^6.5.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0",
    "shelljs": "^0.10.0",
    "zod": "^4.1.13"
  }
}
